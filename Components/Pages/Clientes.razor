@page "/clientes"
@using Routify.Shared.Dtos
@using Routify.App.Services
@inject NavigationManager Navigation
@inject ClienteService ClienteService

<main class="main-card">
    <h1 class="page-title">Clientes</h1>

    <div class="action-bar">
        <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" placeholder="Buscar por nombre o por email" @bind="searchTerm" @bind:event="oninput" @bind:after="CargarClientesAsync" />
        </div>

        <button class="btn-new-client">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Nuevo cliente</span>
        </button>
    </div>

    @if (cargando)
    {
        <p>Cargando clientes...</p>
    }
    else if (errorMessage is not null)
    {
        <p class="error-message">@errorMessage</p>
    }
    else
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Registrado</th>
                        <th class="center-col">Pedidos</th>
                        <th class="right-col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in clientes)
                    {
                        <tr>
                            <td>@cliente.Nombre @cliente.Apellido</td>
                            <td>@cliente.Email</td>
                            <td>@cliente.Telefono</td>
                            <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td class="center-col">@cliente.CantidadPedidos</td>
                            <td class="right-col">-</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>

@code {
    private string searchTerm = "";
    private List<ClienteDto> clientes = new();
    private bool cargando = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientesAsync();
    }

    private async Task CargarClientesAsync()
    {
        cargando = true;
        errorMessage = null;
        try
        {
            clientes = await ClienteService.ObtenerTodosAsync(searchTerm);
        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }
}