@page "/sesion"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Routify.App.Services
@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="login-container">
    <div class="login-left">
        <div class="brand">
            <img src="img/logo.png" alt="Routify Icon" class="brand-icon" />
            <img src="img/routify.png" alt="Routify" class="brand-wordmark" />
            <p class="brand-tagline">Rutas claras, entregas seguras.</p>
        </div>
    </div>

    <div class="login-right">
        <div class="login-form">
            <h1 class="login-title">Iniciar sesión</h1>
            <p class="login-subtitle">Bienvenido de nuevo!</p>

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="userId">Id de usuario</label>
                    <InputText id="userId" class="form-input" @bind-Value="loginModel.UserId" />
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <InputText id="password" type="password" class="form-input" @bind-Value="loginModel.Password" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="error-message">@errorMessage</p>
                }

                <div class="button-row">
                    <button type="submit" class="btn-entrar" disabled="@isLoading">
                        @(isLoading ? "Ingresando..." : "Entrar")
                    </button>
                </div>
            </EditForm>
        </div>

        <button type="button" class="back-button" @onclick="GoBack" aria-label="Volver">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool isLoading = false;
    private string? errorMessage;

    public class LoginModel
    {
        [Required(ErrorMessage = "Ingresá tu id de usuario")]
        public string UserId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresá tu contraseña")]
        public string Password { get; set; } = string.Empty;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        var (exito, error) = await AuthService.LoginAsync(loginModel.UserId, loginModel.Password);

        isLoading = false;

        if (exito)
        {
            Navigation.NavigateTo("/clientes");
        }
        else
        {
            errorMessage = error ?? "No se pudo iniciar sesión.";
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}